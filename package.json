{
  "name": "csa-phishing-awareness-demo",
  "version": "2.0.0",
  "description": "CSA / CBAC controlled phishing simulation for security awareness training. Supports multiple concurrent instructors, SQLite session persistence and per-session logging.",
  "main": "relay.js",
  "scripts": {
    "start": "node relay.js",
    "setup": "npm install",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky install"
  },
  "keywords": [
    "cybersecurity",
    "phishing",
    "awareness",
    "training",
    "csa",
    "cert-gh"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  }
}
